{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Akik-Forazi/mcp",
  "title": "Fraziym MCP",
  "description": "Fastest, most secure MCP toolbelt - 74 tools + router/fix/brain gateway (2026-07-28 + legacy).",
  "version": "0.1.1-beta.0",
  "websiteUrl": "https://github.com/Akik-Forazi/MCP#readme",
  "repository": {
    "url": "https://github.com/Akik-Forazi/MCP",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@fraziym/mcp",
      "version": "0.1.1-beta.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve",
          "valueHint": "command"
        }
      ]
    }
  ]
}
