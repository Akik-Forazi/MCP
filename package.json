{
  "name": "@fraziym/mcp",
  "version": "0.1.1-beta.0",
  "mcpName": "io.github.Akik-Forazi/mcp",
  "description": "Fraziym MCP — fastest, most secure MCP toolbelt server: 74 tools (files, shell, web, code, axodex, git, memory), dual-era protocol 2026-07-28 + legacy, plus router/fix/brain gateway endpoints.",
  "keywords": [
    "ai",
    "agent",
    "tool-use",
    "mcp",
    "tools",
    "fraziym",
    "axoniz",
    "xorvoid"
  ],
  "homepage": "https://github.com/Akik-Forazi/MCP#readme",
  "bugs": {
    "url": "https://github.com/Akik-Forazi/MCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akik-Forazi/MCP.git"
  },
  "license": "MIT",
  "author": "AKIK FARAJI <akikfaraji@gmail.com> (https://fraziym.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./xorvoid": {
      "types": "./dist/groups/xorvoid.d.ts",
      "import": "./dist/groups/xorvoid.js"
    },
    "./axoniz": {
      "types": "./dist/groups/axoniz.d.ts",
      "import": "./dist/groups/axoniz.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fraziym-mcp": "dist/cli/index.js"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "bin",
    "catalog.json",
    "README.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run catalog",
    "catalog": "node --experimental-strip-types scripts/gen-catalog.ts",
    "bench": "node --experimental-strip-types src/cli/index.ts bench",
    "bench:competitors": "node --experimental-strip-types src/cli/index.ts bench --competitors",
    "prove": "node --experimental-strip-types src/cli/index.ts prove",
    "fuzz": "node --experimental-strip-types src/cli/index.ts fuzz",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "docs": "node --experimental-strip-types scripts/gen-tool-docs.ts",
    "mcpb:pack": "npx --yes @anthropic-ai/mcpb pack",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:exe": "node scripts/build-exe.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run build:exe"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fraziym/axoniz": ">=0.1.8-beta.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@fraziym/axodex@0.1.5-beta.1": true,
    "node-llama-cpp@3.22.1": true,
    "@ladybugdb/core@0.21.1": true,
    "@scarf/scarf@1.4.0": true,
    "tree-sitter@0.21.1": true
  }
}
