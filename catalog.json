        "axoniz",
        "xorvoid",
        "qaTools",
        "secTools"
      ],
      "description": "Read a file with line numbers. Optional start_line/end_line range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path (relative to workspace)",
            "maxLength": 4096
          },
          "start_line": {
            "type": "integer",
            "description": "First line (1-based)"
          },
          "end_line": {
            "type": "integer",
            "description": "Last line"
          }
        },
        "required": [
          "path"
        ]
      },
      "meta": {
        "readOnly": true
      }
    },
